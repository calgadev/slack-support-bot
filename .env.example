# Copy to .env and fill in real values. Never commit .env.

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Gemini (model names: see https://ai.google.dev/gemini-api/docs/models)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Eval judge model (optional, defaults to GEMINI_MODEL)
GEMINI_JUDGE_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=4
GEMINI_MAX_OUTPUT_TOKENS=1024

# Retrieval
KNOWLEDGE_BASE_DIR=knowledge_base
RETRIEVAL_TOP_K=4
# Minimum cosine similarity for a chunk to count as relevant (calibrated with the eval set)
RETRIEVAL_MIN_SCORE=0.65

# Guardrails
MAX_INPUT_CHARS=2000

# Tickets: how long a ticket draft can be confirmed, and how often expired rows are purged
PENDING_ACTION_TTL_SECONDS=900
CLEANUP_INTERVAL_SECONDS=600

# Storage (Chroma index, SQLite database and heartbeat file live here)
DATA_DIR=data

# Logging and privacy (user ids are logged only as salted hashes)
LOG_LEVEL=INFO
USER_ID_HASH_SALT=replace-with-a-random-string

# How long processed Slack event ids are kept for de-duplication
PROCESSED_EVENT_TTL_SECONDS=86400

# Health
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_MAX_AGE_SECONDS=90
